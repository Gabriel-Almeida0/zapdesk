  "private": true,
  "description": "App desktop do ZapDesk (Electron + React)",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "compilar": "electron-vite build",
    "previa": "electron-vite preview",
